void reverse(char **s, int start, int end) {
    while (start < end) {
        char *tmp = s[start];
        s[start] = s[end];
        s[end] = tmp;
        start++;
        end--;
    }
}
int next_permutation(int n, char **s) {
    // Step 1: Find the longest non-increasing suffix
    int i = n - 2;
    while (i >= 0 && strcmp(s[i], s[i + 1]) >= 0) {
        i--;
    }
    if (i < 0) return 0;
    int j = n - 1;
    while (strcmp(s[j], s[i]) <= 0) {
        j--;
    }
    char *tmp = s[i];
    s[i] = s[j];
    s[j] = tmp;
    reverse(s, i + 1, n - 1);
    return 1;
}
