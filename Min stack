#include <stdlib.h>
#define MAX_CALLS 30005
typedef struct {
    int* valStack;  
    int* minStack; 
    int top;        
} MinStack;
MinStack* minStackCreate() {
    MinStack* obj = (MinStack*)malloc(sizeof(MinStack));
    obj->valStack = (int*)malloc(MAX_CALLS * sizeof(int));
    obj->minStack = (int*)malloc(MAX_CALLS * sizeof(int));
    obj->top = -1;
    return obj;
}
void minStackPush(MinStack* obj, int value) {
    obj->top++;
    obj->valStack[obj->top] = value;
    if (obj->top == 0) {
        obj->minStack[obj->top] = value;
    } else {
        int currentMin = obj->minStack[obj->top - 1];
        obj->minStack[obj->top] = (value < currentMin) ? value : currentMin;
    }
}
void minStackPop(MinStack* obj) {
    if (obj->top >= 0) {
        obj->top--;
    }
}
int minStackTop(MinStack* obj) {
    return obj->valStack[obj->top];
}
int minStackGetMin(MinStack* obj) {
    return obj->minStack[obj->top];
}
void minStackFree(MinStack* obj) {
    free(obj->valStack);
    free(obj->minStack);
    free(obj);
}
