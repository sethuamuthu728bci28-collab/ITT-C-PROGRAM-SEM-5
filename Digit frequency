#include <stdio.h>
#include <string.h>
int main() {
    char s[1001];
    int frequency[10] = {0};
    if (scanf("%1000s", s) != 1) {
        return 0;
    }
    for (int i = 0; s[i] != '\0'; i++) {
        if (s[i] >= '0' && s[i] <= '9') {
            frequency[s[i] - '0']++;
        }
    }
    for (int i = 0; i < 10; i++) {
        printf("%d", frequency[i]);
        if (i < 9) {
            printf(" ");
        }
    }
    printf("\n");

    return 0;
}
