#include <stdio.h>
#include <stdlib.h>
int findMaximumLength(int* nums, int numsSize) {
    long long* prefixSum = (long long*)calloc(numsSize + 1, sizeof(long long));
    for (int i = 0; i < numsSize; i++) {
        prefixSum[i + 1] = prefixSum[i] + nums[i];
    }
    int* dp = (int*)calloc(numsSize + 1, sizeof(int));
    long long* last = (long long*)calloc(numsSize + 1, sizeof(long long));
    int* queue = (int*)malloc((numsSize + 1) * sizeof(int));
    int head = 0;
    int tail = 0;
    dp[0] = 0;
    last[0] = 0;
    queue[tail++] = 0;
    for (int i = 1; i <= numsSize; i++) {
        while (head + 1 < tail && prefixSum[i] >= prefixSum[queue[head + 1]] + last[queue[head + 1]]) {
            head++;
        }
        int j = queue[head];
        dp[i] = dp[j] + 1;
        last[i] = prefixSum[i] - prefixSum[j];
        long long currentTarget = prefixSum[i] + last[i];
        while (tail > head) {
            int prevIdx = queue[tail - 1];
            long long prevTarget = prefixSum[prevIdx] + last[prevIdx];
            if (currentTarget <= prevTarget) {
                tail--;
            } else {
                break;
            }
        }
        queue[tail++] = i;
    }
    int result = dp[numsSize];
    free(prefixSum);
    free(dp);
    free(last);
    free(queue);

    return result;
}
