#include <math.h>
int kadane(int* nums, int numsSize) {
    int max_so_far = nums[0];
    int curr_max = nums[0];
    for (int i = 1; i < numsSize; i++) {
        curr_max = (nums[i] > curr_max + nums[i]) ? nums[i] : curr_max + nums[i];
        if (curr_max > max_so_far) {
            max_so_far = curr_max;
        }
    }
    return max_so_far;
}
int maxSubarraySumCircular(int* nums, int numsSize) {
    int max_normal = kadane(nums, numsSize);
    if (max_normal < 0) {
        return max_normal;
    }
    int total_sum = 0;
    int min_so_far = nums[0];
    int curr_min = nums[0];
    total_sum += nums[0];
    for (int i = 1; i < numsSize; i++) {
        total_sum += nums[i];
        curr_min = (nums[i] < curr_min + nums[i]) ? nums[i] : curr_min + nums[i];
        if (curr_min < min_so_far) {
            min_so_far = curr_min;
        }
    }
    int max_circular = total_sum - min_so_far;
    return (max_normal > max_circular) ? max_normal : max_circular;
}
